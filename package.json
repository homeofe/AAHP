{
  "name": "@elvatis_com/aahp",
  "version": "3.12.0",
  "description": "AI-to-AI Handoff Protocol - CLI tools for managing agent handoff files",
  "author": "Elvatis <emre.kohler@elvatis.com>",
  "bin": {
    "aahp": "bin/aahp.js"
  },
  "keywords": [
    "ai",
    "handoff",
    "protocol",
    "agent",
    "llm",
    "ai-agent",
    "context-handoff",
    "multi-agent"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homeofe/AAHP.git"
  },
  "homepage": "https://github.com/homeofe/AAHP#readme",
  "bugs": {
    "url": "https://github.com/homeofe/AAHP/issues"
  },
  "files": [
    "bin/",
    "scripts/",
    "!scripts/**/__pycache__/",
    "!scripts/**/*.pyc",
    "!scripts/**/*.pyo",
    "!scripts/ROLLOUT.md",
    "assets/",
    "templates/",
    "schema/",
    "aahp.config.example.json",
    "CHANGELOG.md",
    "CONSTITUTION.md",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "check:changelog": "node scripts/check-changelog.mjs",
    "check:changelog-format": "node scripts/check-changelog-format.mjs",
    "check:version-sync": "node scripts/check-version-sync.mjs",
    "check:claims": "node scripts/check-claims.mjs",
    "check:forbidden-patterns": "node scripts/check-forbidden-patterns.mjs",
    "check:schema-doc-sync": "node scripts/check-schema-doc-sync.mjs",
    "check:doc-links": "node scripts/check-doc-links.mjs",
    "check:doc-shape": "node scripts/check-doc-shape.mjs",
    "check:adr-refs": "node scripts/check-adr-refs.mjs",
    "check:runtime-support": "node scripts/check-runtime-support.mjs",
    "check:workflow-pinning": "node scripts/check-workflow-pinning.mjs",
    "check:handoff": "node scripts/aahp-dashboard.mjs --check",
    "check:bats-negations": "node tests/assert-bats-negations.mjs",
    "check:ascii": "node scripts/check-ascii.mjs",
    "handoff:refresh": "node scripts/aahp-dashboard.mjs",
    "check": "npm run check:changelog && npm run check:changelog-format && npm run check:version-sync && npm run check:claims && npm run check:forbidden-patterns && npm run check:schema-doc-sync && npm run check:doc-links && npm run check:doc-shape && npm run check:adr-refs && npm run check:runtime-support && npm run check:workflow-pinning && npm run check:handoff && npm run check:bats-negations && npm run check:ascii",
    "criteria": "node bin/aahp.js criteria .",
    "doctor": "node bin/aahp.js doctor .",
    "test": "node scripts/run-bats.mjs",
    "prepublishOnly": "npm run check && npm run doctor && npm test"
  },
  "devDependencies": {
    "ajv-cli": "5.0.0",
    "ajv-formats": "3.0.1",
    "bats": "^1.13.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "fast-json-patch": "^3.1.1"
  }
}
