# Enforce LF line endings for shell scripts (prevents CRLF shellcheck errors)
*.sh text eol=lf
*.bash text eol=lf
*.bats text eol=lf

# The git hooks have no extension, so `*.sh` above never reached them, and a
# Windows checkout with core.autocrlf wrote them CRLF. Git Bash runs a CRLF
# script without complaint, so the machine that produced such a copy never
# sees the defect; Linux bash rejects it (`set: pipefail: invalid option
# name`). install-hooks.sh also strips CR when it copies, for checkouts made
# before this line existed.
scripts/hooks/* text eol=lf
